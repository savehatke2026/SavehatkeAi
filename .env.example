# ============================================================
# SaveHatke AI — environment variables
#
# Copy this file to .env.local for local development:
#     cp .env.example .env.local
#
# On Vercel, add each variable under:
#     Project → Settings → Environment Variables
#
# NEVER commit .env.local or any real secret — it is gitignored.
# Every value here is read only by server-side code (api/**, lib/,
# middleware.js). None of them are ever sent to the browser.
# ============================================================

# ------------------------------------------------------------
# Google OAuth 2.0 client (sign-in)
# ------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials →
#   Create credentials → OAuth client ID → Web application
#
# The client id appears in the OAuth redirect URL; that is normal and
# safe. A server-side redirect flow is used, so no client secret or
# token is ever handled by browser JavaScript.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# SECRET. Shown once when the OAuth client is created. Proves the
# authorization-code exchange comes from your application.
GOOGLE_CLIENT_SECRET=your-client-secret

# ------------------------------------------------------------
# Session signing
# ------------------------------------------------------------
# SECRET. Signs the session cookie, the OAuth state cookie, and the PKCE
# verifier. Anyone holding this can forge a session cookie.
#
# Generate with:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Rotating it instantly invalidates every existing session.
SESSION_SECRET=replace-with-a-long-random-string

# ------------------------------------------------------------
# Google Sheet whitelist
# ------------------------------------------------------------
# The spreadsheet ID from its URL:
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=your-spreadsheet-id

# Optional. Defaults to the first tab, columns A:B (Email, Status).
# Pin an explicit tab when the spreadsheet has more than one:
#     GOOGLE_SHEET_RANGE=Whitelist!A:B
GOOGLE_SHEET_RANGE=A:B

# ------------------------------------------------------------
# Google service account (server-side Sheets access)
# ------------------------------------------------------------
# SECRET. Google Cloud Console → IAM & Admin → Service accounts →
# Create → Keys → Add key → Create new key → JSON.
#
# Then SHARE the spreadsheet with the service account's email address
# (Viewer is enough) — exactly as you would share it with a person.
# The sheet stays private; only this account can read it.
#
# Provide the credentials EITHER as the two discrete values...

GOOGLE_SERVICE_ACCOUNT_EMAIL=savehatke-sheets@your-project.iam.gserviceaccount.com

# The private_key value copied verbatim, keeping its \n escapes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ...OR as the whole downloaded JSON key file, base64-encoded:
#     node -e "console.log(require('fs').readFileSync('key.json').toString('base64'))"
# GOOGLE_SERVICE_ACCOUNT_JSON=

# ------------------------------------------------------------
# Sheet layout
#   column A = Email, column B = Status
#     active                        → allowed in
#     anything else ("disabled", …) → refused
#     email absent entirely         → refused
#
# Example:
#   | Email             | Status   |
#   | you@gmail.com     | active   |
#   | someone@gmail.com | disabled |
# ------------------------------------------------------------

# ------------------------------------------------------------
# On-device AI model (primary — the real generator)
# ------------------------------------------------------------
# SaveHatke AI's answers are generated by a REAL open-weight language model
# that runs entirely in the user's browser over WebGPU (via WebLLM). No
# prompt ever leaves the device and no third-party AI API is contacted.
#
# The server owns this configuration and hands the NON-SECRET parts to an
# authorized browser through GET /api/ai/config. None of these are secrets
# (a model id and a temperature are safe to expose); the browser reads them
# to know which model to download and how to sample it. All are optional —
# the defaults shown are what ship if you set nothing.
#
# runtime: how inference happens. Leave as the default unless you run a
# separate self-hosted inference server (see the fallback note below).
#   browser-webllm  (default) real model in the browser over WebGPU
#   server-upstream           a self-hosted OpenAI-compatible runtime
# MODEL_RUNTIME=browser-webllm

# The open-weight model the browser downloads once (then cached). Must be an
# id WebLLM knows (MLC prebuilt list). Larger = smarter but heavier to load;
# the default is chosen for intelligence per resource on typical laptops.
#   Alternatives: Llama-3.2-1B-Instruct-q4f16_1-MLC,
#                 Llama-3.2-3B-Instruct-q4f16_1-MLC,
#                 Qwen2.5-3B-Instruct-q4f16_1-MLC,
#                 Qwen2.5-0.5B-Instruct-q4f16_1-MLC (smallest / fastest)
# MODEL_NAME=Qwen2.5-1.5B-Instruct-q4f16_1-MLC
# MODEL_LABEL=SaveHatke AI (Qwen2.5 1.5B, on-device)
# MODEL_FORMAT=MLC-q4f16_1

# Generation limits and sampling — real knobs the engine honours.
# MODEL_CONTEXT_SIZE=4096
# MODEL_MAX_OUTPUT_TOKENS=1024
# MODEL_TEMPERATURE=0.7
# MODEL_TOP_P=0.95
# MODEL_TOP_K=40

# Optional: where the model weights/libraries are fetched from. Empty uses
# WebLLM's default published host (HuggingFace/GitHub — allowed in the CSP
# connect-src). Point this at your own mirror to remove the last
# third-party dependency and make the deployment fully self-controlled.
# If you set a custom host, add it to connect-src in vercel.json.
# MODEL_HOST=

# Fallback for devices WITHOUT WebGPU: if you run a self-hosted, OpenAI-
# compatible inference server and set SAVEHATKE_MODEL_API_URL below, the
# browser is told a server runtime exists and uses it (via /api/chat) when
# it cannot run the on-device model. It NEVER falls back to a rule-based
# engine, and the URL/key are never exposed to the browser.

# ------------------------------------------------------------
# Chatbot engine
# ------------------------------------------------------------
# POST /api/chat is answered by the built-in SaveHatke AI engine by
# default. It is a small, CPU-only, dependency-free classifier + retrieval
# engine — it needs no API key, no GPU and no network, and its model files
# are committed under server/models/ai/.
#
# Which engine answers is chosen here, not in the frontend. The response
# shape is always { reply, source }, so switching engines requires no
# browser change.
#
#   AI_PROVIDER=SAVEHATKE_AI  (default) the built-in engine
#   AI_PROVIDER=UPSTREAM_MODEL          an OpenAI-compatible endpoint
#
# GEMINI is accepted as an alias for UPSTREAM_MODEL, for a Gemini
# OpenAI-compatible endpoint. There is no Gemini SDK in this repository.
# AI_PROVIDER=SAVEHATKE_AI

# Master switch. Set to false to stop using the built-in engine; traffic
# then goes to SAVEHATKE_MODEL_API_URL if that is configured, and to the
# built-in preview engine if it is not.
# AI_ENABLED=true

# --- Legacy upstream model endpoint (optional) ---
# Only used when AI_PROVIDER=UPSTREAM_MODEL (or AI_ENABLED=false).
# Leave unset and the built-in engine answers every request.
# SAVEHATKE_MODEL_API_URL=https://api.openai.com/v1/chat/completions
# SAVEHATKE_MODEL_API_KEY=sk-...
# SAVEHATKE_MODEL_NAME=gpt-4o-mini

# --- Live data sources ---
# Base URL of the SaveHatke application API that the engine's tools are
# allowed to call for live data (listings, earnings, payouts, tickets).
#
# This is what keeps the engine honest: it never invents a listing, an
# amount or a status. When this is unset, or the call fails, user-data
# questions answer "I could not retrieve that information" rather than
# guessing.
# AI_API_BASE_URL=https://app.savehatke.com

# --- Engine tunables (optional — defaults shown) ---
# Below this confidence the engine asks for clarification instead of
# guessing, and never runs a tool on a low-confidence guess.
# AI_CONFIDENCE_THRESHOLD=0.55

# At or above this confidence a tool may run on the classifier's own
# evidence, without a hand-written rule also matching.
# AI_HIGH_CONFIDENCE=0.8

# Flat seller rate, in rupees, per SOLD eligible coupon. This is the single
# source of truth for the earnings calculation: total = rate × sold.
# AI_SELLER_RATE_PER_COUPON=10

# Per-request and per-tool timeouts, in milliseconds.
# AI_TIMEOUT=8000
# AI_API_TIMEOUT=4000

# Upper bound on a single chat message. /api/chat enforces the same limit.
# AI_MAX_MESSAGE_LENGTH=4000

# 'silent' disables the per-turn structured log line entirely.
# AI_LOG_LEVEL=info

# ------------------------------------------------------------
# Tunables (optional — defaults shown)
# ------------------------------------------------------------
# How long a signed-in user stays signed in. Authorization is re-checked
# far more often than this, so revocation does NOT depend on it.
# SESSION_MAX_AGE_SECONDS=604800

# How long the whitelist is cached before the sheet is re-read. This is
# the delay between editing the sheet and the change taking effect.
# WHITELIST_CACHE_TTL_SECONDS=60

# If Google Sheets is briefly unreachable, how long a recent snapshot may
# still be trusted so an outage does not lock everyone out.
# WHITELIST_STALE_GRACE_SECONDS=120

# How long a started sign-in attempt remains valid.
# LOGIN_NONCE_MAX_AGE_SECONDS=600