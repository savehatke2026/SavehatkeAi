{
  "version": "1.0.0",
  "note": "Intent metadata for the SaveHatke AI rule layer. `patterns` are high-precision regexes used to boost a classifier result (they never decide alone). `tool` names a toolRouter tool or null. `permission` mirrors toolRouter's permission levels.",
  "thresholds": {
    "high": 0.8,
    "medium": 0.55
  },
  "intents": {
    "GREETING": {
      "description": "Opening pleasantries.",
      "patterns": [
        "^(hi|hey|hello|yo|hii+|namaste|greetings)\\b",
        "\\bgood (morning|afternoon|evening)\\b",
        "\\bhow are you\\b",
        "\\bkaise ho\\b",
        "\\b(nice|good|great|glad|lovely|pleased) to (see|meet) you\\b",
        "\\bhow do you do\\b",
        "\\bwhats up\\b",
        "\\bhow is it going\\b"
      ],
      "keywords": [
        "hi",
        "hello",
        "hey",
        "namaste",
        "greetings",
        "morning",
        "evening"
      ],
      "tool": null,
      "permission": "PUBLIC",
      "knowledgeCategories": [],
      "trainable": true
    },
    "GOODBYE": {
